"motor_run\main.o"
"motor_run\gpio.o"
"motor_run\tim.o"
"motor_run\usart.o"
"motor_run\stm32g0xx_it.o"
"motor_run\stm32g0xx_hal_msp.o"
"motor_run\stm32g0xx_hal_tim.o"
"motor_run\stm32g0xx_hal_tim_ex.o"
"motor_run\stm32g0xx_hal_rcc.o"
"motor_run\stm32g0xx_hal_rcc_ex.o"
"motor_run\stm32g0xx_ll_rcc.o"
"motor_run\stm32g0xx_hal_flash.o"
"motor_run\stm32g0xx_hal_flash_ex.o"
"motor_run\stm32g0xx_hal_gpio.o"
"motor_run\stm32g0xx_hal_dma.o"
"motor_run\stm32g0xx_hal_dma_ex.o"
"motor_run\stm32g0xx_ll_dma.o"
