--cpu Cortex-M0+
"objects\startup_stm32g030xx.o"
"objects\main.o"
"objects\motor_pwm.o"
"objects\stm32g0xx_it.o"
"objects\stm32g0xx_hal_msp.o"
"objects\gpio.o"
"objects\tim.o"
"objects\stm32g0xx_hal_tim.o"
"objects\stm32g0xx_hal_tim_ex.o"
"objects\stm32g0xx_hal_rcc.o"
"objects\stm32g0xx_hal_rcc_ex.o"
"objects\stm32g0xx_ll_rcc.o"
"objects\stm32g0xx_hal_flash.o"
"objects\stm32g0xx_hal_flash_ex.o"
"objects\stm32g0xx_hal_gpio.o"
"objects\stm32g0xx_hal_dma.o"
"objects\stm32g0xx_hal_dma_ex.o"
"objects\stm32g0xx_ll_dma.o"
"objects\stm32g0xx_hal_pwr.o"
